{
  "name": "@lintkit/stylelint-config",
  "version": "1.1.0",
  "type": "module",
  "description": "LintKit: Stylelint Config",
  "author": "Mike Street <mike@liquidlight.co.uk>",
  "homepage": "https://github.com/lintkit/stylelint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lintkit/stylelint-config.git"
  },
  "bugs": {
    "url": "https://github.com/lintkit/stylelint-config/issues"
  },
  "license": "ISC",
  "dependencies": {
    "@stylistic/stylelint-plugin": "^3.0",
    "stylelint": "^16.8",
    "stylelint-config-standard-scss": "^13.1",
    "stylelint-scss": "^6.3"
  },
  "devDependencies": {
    "@lintkit/eslint-config": "^2.2.0"
  },
  "scripts": {
    "eslint:dry-run": "eslint . --color --cache --config node_modules/@lintkit/eslint-config/eslint.config.js --cache-location .cache/ --cache-strategy content",
    "eslint:fix": "npm run eslint:dry-run -- --fix"
  }
}
